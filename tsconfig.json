{
  "include": [
    "index.js",
    "./src/**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "allowUmdGlobalAccess": true
  }
}
